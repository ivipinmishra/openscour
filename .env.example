# Copy to .env and adjust. All settings are optional.

# Comma-separated API keys clients must send as "Authorization: Bearer <key>". Empty = auth off.
API_KEYS=

SEARXNG_URL=http://localhost:8888
DUCKDUCKGO_FALLBACK=true
# Comma-separated proxies for search engine queries (http, https, socks5, socks5h),
# e.g. http://user:password@proxy.example.com:8080. Docker Compose passes them to SearXNG too.
SEARCH_PROXIES=

# Optional AI answers for include_answer: none | bedrock | anthropic
ANSWER_PROVIDER=none
ANSWER_MODEL=claude-opus-5-5
AWS_REGION=us-east-1

FETCH_TIMEOUT=8
CACHE_TTL_SECONDS=3600

# Security (see "Security" in the README)
# USER_AGENT defaults to OpenScour/<version> (+https://github.com/ivipinmishra/openscour)
# USER_AGENT=
RESPECT_ROBOTS_TXT=true
# Only for trusted, internal-only deployments that must read intranet pages.
ALLOW_PRIVATE_NETWORK_FETCHES=false

# Limits
FETCH_CONCURRENCY=10
MAX_INFLIGHT_FETCHES=200
EXTRACT_MAX_TASKS_PER_CHILD=500

# Requests per minute per API key (or per client IP when auth is off). 0 = off.
RATE_LIMIT_PER_MINUTE=60
# Only behind a load balancer that sets X-Forwarded-For.
TRUST_FORWARDED_FOR=false
